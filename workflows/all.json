entials":{"mongoDb":{"id":"mhVCtNzzRI4MNaJQ","name":"MongoDB account"}}},{"parameters":{"jsCode":"// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n  item.json.token = gerarSenha(12);\n}\n\nreturn $input.all();\n\n\n\nfunction gerarSenha(comprimento) {\n    const minusculas = 'abcdefghijklmnopqrstuvwxyz';\n    const maiusculas = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';\n    const numeros = '0123456789';\n    \n    // Agrupa todos os caracteres permitidos\n    const todosCaracteres = minusculas + maiusculas + numeros;\n    let senha = '';\n\n    // Garante que a senha tenha pelo menos um de cada tipo para ser forte\n    senha += minusculas[Math.floor(Math.random() * minusculas.length)];\n    senha += maiusculas[Math.floor(Math.random() * maiusculas.length)];\n    senha += numeros[Math.floor(Math.random() * numeros.length)];\n\n    // Preenche o restante do comprimento solicitado\n    for (let i = senha.length; i < comprimento; i++) {\n        const indiceAleatorio = Math.floor(Math.random() * todosCaracteres.length);\n        senha += todosCaracteres.charAt(indiceAleatorio);\n    }\n\n    // Embaralha a senha final para que os primeiros caracteres não sigam o padrão fixo\n    return senha.split('').sort(() => 0.5 - Math.random()).join('');\n}"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-368,-128],"id":"36f7f94a-ca3d-405b-840a-9bae1565746c","name":"Create Token"},{"parameters":{},"type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1.1,"position":[-640,-128],"id":"c94a27a1-feb6-4a33-9ea5-7301d1f0ff21","name":"When.AdminFlow"},{"parameters":{"workflowId":{"__rl":true,"value":"zw5c5xRgg101UJDA","mode":"list","cachedResultUrl":"/workflow/zw5c5xRgg101UJDA","cachedResultName":"TeAjuda.Tenant.Connect"},"workflowInputs":{"mappingMode":"defineBelow","value":{},"matchingColumns":[],"schema":[],"attemptToConvertTypes":false,"convertFieldsToString":true},"options":{}},"type":"n8n-nodes-base.e